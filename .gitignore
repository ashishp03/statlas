__pycache__/
*.pyc
.venv/
venv/
*.duckdb
*.duckdb.wal
.env
.DS_Store
.pytest_cache/
*.egg-info/

# Locally-installed agent skills (via `npx skills`) live in /.agents/skills/ — this is now the
# tracked source of truth, so any tool's skills/ dir (.claude/skills/, .codex/skills/, ...) can
# symlink to it without duplicating content. .claude/skills/* already holds materialized (real,
# non-symlink) copies of the skills worth keeping — tracked directly, exceptions below.
/.claude/skills/*
!/.claude/skills/run-notebook/
!/.claude/skills/find-skills/
!/.claude/skills/attach-db/
!/.claude/skills/convert-file/
!/.claude/skills/duckdb-docs/
!/.claude/skills/install-duckdb/
!/.claude/skills/read-memories/

# Folder-typed ignores: personal/generated content lives in named subfolders so we ignore the
# folder, not a filename pattern — that way a stray wanted .md never gets swept up by a blanket
# rule. Anything meant to be tracked stays OUTSIDE these folders.

# Root-level docs that are personal reference/research, not project setup (AGENTS.md, CLAUDE.md,
# README.md, and the .claude/.codex tooling stay at root, tracked).
docs/research/
docs/onboarding/

# Per-experiment: hand-authored prose write-ups (findings, decisions, summaries, walkthroughs)
# that are personal working notes, not a repo deliverable. The actual deliverable is the
# pipeline code + eval_set.json + ARCHITECTURE.md, which live outside this folder.
experiments/**/docs/findings/

# Per-experiment: all generated/reproducible output — materialized data, benchmark result
# tables/figures, the pipeline's own generated write-ups (RESULTS.md, t2sql_examples.md,
# vector_findings.md live here too, written by S4/S5/S6) — rebuild via the pipeline, never stage.
experiments/**/data/
experiments/**/results/

# Frozen/resolved eval-set snapshot — a build artifact regenerated by the pipeline (S3), not
# hand-authored content like eval_set.json itself.
experiments/**/eval_set_resolved.json

# Regeneratable chart output anywhere else (e.g. notebooks/) — rebuild via the pipeline.
*.svg

# npx-skills lockfile — local install bookkeeping, same "kept per-branch, not committed" bucket
# as the skills themselves above.
/skills-lock.json
